# Adresse publique du site (sitemap, métadonnées)
NEXT_PUBLIC_SITE_URL=https://www.exemple-propulscom.ci

# Contact affiché sur le site (indicatif pays sans le +, ex. 2250700000000)
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_CONTACT_EMAIL=

# Supabase : enregistrement des demandes (clés à copier depuis Project Settings > API)
# La clé service_role ne doit JAMAIS être exposée au navigateur : pas de préfixe NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Notification par e-mail à l'agence (facultatif, via Resend)
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=
